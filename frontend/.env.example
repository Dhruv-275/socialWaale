# ==============================================================================
# Social Waale CMS - Frontend Environment Configuration Template
# ==============================================================================
# Copy this file to .env:
#   cp .env.example .env
#
# DO NOT COMMIT REAL SENSITIVE SECRETS TO GIT.

# Base URL pointing to the deployed or local Backend Express API service
VITE_API_URL=http://localhost:5000/api

# Canonical Site URL (Used for sitemaps, robots.txt, metadata, and canonical links)
VITE_SITE_URL=http://localhost:8080

# Optional Supabase Integration (Client-Side Publishable Keys only)
VITE_SUPABASE_PROJECT_ID=your_supabase_project_id
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
VITE_SUPABASE_URL=https://your-project.supabase.co
