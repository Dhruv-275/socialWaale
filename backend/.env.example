# ==============================================================================
# Social Waale CMS - Backend Environment Configuration Template
# ==============================================================================
# Copy this file to .env:
#   cp .env.example .env
#
# DO NOT COMMIT REAL SENSITIVE SECRETS TO GIT.

# Server Port (Hosting platforms like Render, Railway, Heroku automatically set PORT)
PORT=5000

# Environment Mode: development | production | test
NODE_ENV=production

# JWT and Session signing secret key (Use a strong 64-character random string)
SESSION_SECRET=replace-with-a-secure-random-64-character-secret-key

# Allowed CORS Origins (Comma-separated for multiple origins)
# Example: http://localhost:8080,https://socialwaale.com,https://your-frontend.vercel.app
CORS_ORIGIN=http://localhost:8080,http://localhost:3000,http://127.0.0.1:8080

# Primary JSON CMS Database File Location (Defaults to ./data/cms-store.json)
DATABASE_FILE=./data/cms-store.json

# File Upload Directory (Defaults to ./uploads)
UPLOAD_DIR=./uploads

# Instagram Downloader Provider Rate Limiting (Requests per minute)
DOWNLOADER_RATE_LIMIT_PER_MINUTE=60

# Optional Database Migration URL (If using Drizzle ORM with PostgreSQL)
# LOVABLE_DB_MIGRATION_URL=postgresql://username:password@hostname:5432/database_name

# Optional AI Integration (Google Gemini API key if AI copywriting is enabled)
# GEMINI_API_KEY=your_gemini_api_key_here
